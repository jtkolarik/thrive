# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Supabase URL - Get this from your Supabase project settings
# Example: https://xxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=your-supabase-url-here

# Supabase Anon Key - Get this from your Supabase project settings
# This is the public anonymous key (safe to use in client apps)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
